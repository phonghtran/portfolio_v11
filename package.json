		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.3.7"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4"
	},
